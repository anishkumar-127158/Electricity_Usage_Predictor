"""
PS No. 74 - Electricity Usage Predictor
Language: Python 3
Concepts: Pandas, NumPy, Matplotlib, Linear Regression

Run:
    python electricity_predictor.py

CSV format:
    Month,Units
    1,200
    2,220
    3,240
"""

from pathlib import Path
import sys

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

DATA_FILE = Path(__file__).with_name("usage.csv")
RATE_PER_UNIT = 6.0


def load_data(file_path):
    """Load and validate monthly electricity usage from a CSV file."""
    if not file_path.exists():
        raise FileNotFoundError(
            f"CSV file not found: {file_path.name}. "
            "Keep usage.csv in the same folder as this Python file."
        )

    # Read once without assuming a header, then detect whether the first row
    # contains column names or actual numeric data.
    raw = pd.read_csv(file_path, header=None)
    if raw.shape[1] < 2:
        raise ValueError("CSV must contain at least two columns: Month and Units.")

    first_two = pd.to_numeric(raw.iloc[0, :2], errors="coerce")
    if first_two.notna().all():
        data = raw
    else:
        data = pd.read_csv(file_path)

    if len(data.columns) < 2:
        raise ValueError("CSV must contain at least two columns: Month and Units.")

    data = data.iloc[:, :2].copy()
    data.columns = ["Month", "Units"]

    # Convert values to numbers; invalid or missing rows are removed.
    data["Month"] = pd.to_numeric(data["Month"], errors="coerce")
    data["Units"] = pd.to_numeric(data["Units"], errors="coerce")

    invalid_count = int(data[["Month", "Units"]].isna().any(axis=1).sum())
    if invalid_count:
        print(f"Warning: {invalid_count} row(s) with missing/non-numeric values removed.")

    data = data.dropna(subset=["Month", "Units"])

    if len(data) < 2:
        raise ValueError("At least 2 months of valid data are required for regression.")

    if data["Month"].nunique() < 2:
        raise ValueError("Month values must contain at least 2 different months.")

    if (data["Units"] < 0).any():
        raise ValueError("Electricity units cannot be negative.")

    return data.sort_values("Month").reset_index(drop=True)


def train_model(data):
    """Fit y = mx + c and calculate the coefficient of determination (R²)."""
    x = data["Month"].to_numpy(dtype=float)
    y = data["Units"].to_numpy(dtype=float)

    slope, intercept = np.polyfit(x, y, 1)
    predicted = slope * x + intercept

    ss_total = np.sum((y - np.mean(y)) ** 2)
    ss_residual = np.sum((y - predicted) ** 2)

    # R² is undefined when all actual usage values are identical.
    r_squared = 1.0 if np.isclose(ss_total, 0) and np.isclose(ss_residual, 0) else (
        0.0 if np.isclose(ss_total, 0) else 1 - ss_residual / ss_total
    )

    return slope, intercept, r_squared


def predict_usage(month, slope, intercept):
    """Predict electricity units for a given month."""
    return slope * month + intercept


def show_summary(data, slope, intercept, r_squared):
    print("\n========== DATA SUMMARY ==========")
    print(data.to_string(index=False))
    print(f"\nValid records : {len(data)}")
    print(f"Slope         : {slope:.2f}")
    print(f"Intercept     : {intercept:.2f}")
    print(f"R² Score      : {r_squared:.2f}")
    print("==================================\n")


def plot_usage(data, slope, intercept):
    """Plot actual usage points and the fitted regression line."""
    x = data["Month"].to_numpy(dtype=float)
    y = data["Units"].to_numpy(dtype=float)

    line_x = np.linspace(x.min(), x.max(), 100)
    line_y = slope * line_x + intercept

    plt.figure(figsize=(9, 5))
    plt.scatter(x, y, label="Actual Usage", marker="o")
    plt.plot(line_x, line_y, label="Regression Line")
    plt.title("Electricity Usage Prediction")
    plt.xlabel("Month")
    plt.ylabel("Electricity Units")
    plt.grid(True)
    plt.legend()
    plt.tight_layout()
    plt.show()


def main():
    print("======================================")
    print("       ELECTRICITY USAGE PREDICTOR")
    print("======================================")

    try:
        data = load_data(DATA_FILE)
        slope, intercept, r_squared = train_model(data)
    except (FileNotFoundError, ValueError, pd.errors.ParserError) as error:
        print(f"\nError: {error}")
        return

    print(f"\nModel trained successfully using {len(data)} month(s) of data.")
    print(f"Slope: {slope:.2f} | Intercept: {intercept:.2f} | R²: {r_squared:.2f}")

    while True:
        print("\n--------------- MENU ---------------")
        print("1. Predict electricity usage")
        print("2. Show data summary")
        print("3. Display graph")
        print("4. Exit")
        print("------------------------------------")

        choice = input("Enter your choice (1-4): ").strip()

        if choice == "1":
            try:
                month = float(input("Enter month number to predict: "))
                if month <= 0:
                    print("Please enter a month number greater than 0.")
                    continue

                units = predict_usage(month, slope, intercept)
                bill = units * RATE_PER_UNIT

                print("\n--------- PREDICTION RESULT ---------")
                print(f"Month             : {month:g}")
                print(f"Predicted units   : {units:.2f}")
                print(f"Estimated bill    : Rs. {bill:.2f}")
                print("-------------------------------------")
            except ValueError:
                print("Invalid input. Please enter a numeric month.")

        elif choice == "2":
            show_summary(data, slope, intercept, r_squared)

        elif choice == "3":
            plot_usage(data, slope, intercept)

        elif choice == "4":
            print("Thank you for using Electricity Usage Predictor!")
            break

        else:
            print("Invalid choice. Please select 1, 2, 3, or 4.")


if __name__ == "__main__":
    main()
